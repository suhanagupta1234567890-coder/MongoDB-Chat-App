<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EDIT CHAT</title>
</head>
<body>
    <p>EDIT CHAT :<%= chat._id %></p>
    <p> This chat was sent from <b><%= chat.from %></b> to <b><%= chat.to %></b></p>
    <form method = "POST" action = "/chats/<%= chat._id %>?_method=PUT">
        <textarea name = "msg" rows="10" cols="40"><%= chat.msg %></textarea>
        <br>
        <p> Last updated: <%= chat.updated_at ? new Date(chat.updated_at).toLocaleString() : "Not updated" %></p>
        <br>
        <button>Edit chat</button>
    </form>
</body>
</html>